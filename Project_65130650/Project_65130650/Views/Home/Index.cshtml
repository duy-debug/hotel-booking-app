            display: flex;
            justify-content: center;
            margin-top: 40px;
        }

        .btn-view-all {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 16px 40px;
            background: linear-gradient(135deg, #0d4ea6 0%, #1e40af 100%);
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            border-radius: 999px;
            text-decoration: none;
            box-shadow: 0 16px 40px rgba(13, 78, 166, 0.35);
            transition: all 0.3s ease;
        }

        .btn-view-all:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 50px rgba(13, 78, 166, 0.45);
            background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
        }

        .btn-view-all i {
            transition: transform 0.3s ease;
        }

        .btn-view-all:hover i {
            transform: translateX(4px);
        }

        .icon-features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
            margin-top: 8px;
            padding: 10px 12px;
            border-radius: 999px;
            background: #eff6ff;
            color: #0f172a;
            font-size: 13px;
        }

        .icon-features i {
            color: #0d4ea6;
        }

        .reveal {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }

        .reveal--visible {
            opacity: 1;
            transform: translateY(0);
        }

        .dining-slider {
            position: relative;
            overflow: hidden;
            border-radius: 20px;
            margin-top: 12px;
            width: 100%;
        }

        .dining-slider__track {
            display: flex;
            width: 100%;
            transition: transform 0.7s ease-in-out;
        }

        .dining-slider__slide {
            min-width: 100%;
        }

        .dining-slider__slide img {
            width: 100%;
            display: block;
            border-radius: 20px;
            object-fit: cover;
        }

        .dining-slider__control {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border-radius: 999px;
            border: none;
            background: rgba(15, 23, 42, 0.7);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .dining-slider__control--prev {
            left: 10px;
        }

        .dining-slider__control--next {
            right: 10px;
        }

        /* Media Queries */

        @@media (max-width: 1024px) {
            .hero-slider,
            .landing-hero {
                min-height: 80vh;
            }

            .hero-slide h1 {
                font-size: 40px;
            }

            .hero-slide__content {
                padding: 100px 30px 160px;
            }

            .hero-stats-bar {
                gap: 40px;
                padding: 20px 30px;
            }

            .hero-stat strong {
                font-size: 26px;
            }

            .hero-slider__arrow {
                width: 44px;
                height: 44px;
            }

            .hero-slider__arrow--prev {
                left: 15px;
            }

            .hero-slider__arrow--next {
                right: 15px;
            }

            .section,
            .section--alt {
                grid-template-columns: minmax(0, 1fr);
            }

            .featured-rooms-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 640px) {
            .hero-slider,
            .landing-hero {
                min-height: 100vh;
            }

            .hero-slide__content {
                padding: 80px 20px 180px;
            }

            .hero-slide h1 {
                font-size: 28px;
            }
            .lead {
                font-size: 14px;
                line-height: 1.6;
                text-align: left !important;
                margin: 0 !important;
            }

            .hero-slide__cta {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .hero-slide .btn-primary,
            .hero-slide .btn-ghost {
                width: 100%;
                max-width: 260px;
                padding: 12px 24px;
                font-size: 14px;
            }

            .hero-slider__arrow {
                display: none;
            }

            .hero-slider__nav {
                bottom: 130px;
            }

            .hero-slider__dot {
                width: 40px;
            }

            .hero-stats-bar {
                flex-direction: row;
                flex-wrap: wrap;
                gap: 20px;
                padding: 16px 20px;
            }

            .hero-stat {
                flex: 1;
                min-width: 80px;
            }

            .hero-stat strong {
                font-size: 22px;
            }

            .hero-stat span {
                font-size: 10px;
            }

            .section {
                padding: 28px 0;
            }

            .featured-rooms-grid {
                grid-column: 1 / -1;
                grid-template-columns: 1fr;
            }

            .btn-view-all {
                padding: 14px 30px;
                font-size: 14px;
            }

            .room-specs {
                flex-direction: column;
                gap: 8px;
            }
        }

        /* Ẩn footer mặc định của layout trên trang chủ để không bị trùng lặp */
        footer:not(.landing-footer):not(.bg-slate-950) {
            display: none;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var header = document.querySelector('header');
            var headerOffset = header ? header.offsetHeight + 8 : 80;

            function scrollToTarget(selector) {
                var target = document.querySelector(selector);
                if (!target) return;

                var rect = target.getBoundingClientRect();
                var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                var top = rect.top + scrollTop - headerOffset;

                window.scrollTo({
                    top: top,
                    behavior: 'smooth'
                });
            }

            document.querySelectorAll('[data-scroll-target]').forEach(function (el) {
                el.addEventListener('click', function (e) {
                    var selector = el.getAttribute('data-scroll-target');
                    if (!selector) return;
                    e.preventDefault();
                    scrollToTarget(selector);
                });
            });

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('reveal--visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.2
            });

            document.querySelectorAll('.reveal').forEach(function (el) {
                observer.observe(el);
            });

            // ========== HERO SLIDER ==========
            var slides = document.querySelectorAll('.hero-slide');
            var dots = document.querySelectorAll('.hero-slider__dot');
            var prevBtn = document.querySelector('.hero-slider__arrow--prev');
            var nextBtn = document.querySelector('.hero-slider__arrow--next');
            var currentSlide = 0;
            var slideInterval;
            var slideDuration = 6000; // 6 giây mỗi slide

            function goToSlide(index) {
                // Xóa active từ tất cả slides và dots
                slides.forEach(function(slide) {
                    slide.classList.remove('active');
                });
                dots.forEach(function(dot) {
                    dot.classList.remove('active');
                    // Reset progress bar animation
                    var progress = dot.querySelector('.hero-slider__progress');
                    if (progress) {
                        progress.style.animation = 'none';
                        progress.offsetHeight; // Force reflow
                        progress.style.animation = '';
                    }
                });

                // Thêm active cho slide và dot hiện tại
                currentSlide = index;
                if (currentSlide >= slides.length) currentSlide = 0;
                if (currentSlide < 0) currentSlide = slides.length - 1;

                slides[currentSlide].classList.add('active');
                dots[currentSlide].classList.add('active');
            }

            function nextSlide() {
                goToSlide(currentSlide + 1);
            }

            function prevSlide() {
                goToSlide(currentSlide - 1);
            }

            function startAutoPlay() {
                stopAutoPlay();
                slideInterval = setInterval(nextSlide, slideDuration);
            }

            function stopAutoPlay() {
                if (slideInterval) {
                    clearInterval(slideInterval);
                }
            }

            // Event listeners cho dots
            dots.forEach(function(dot, index) {
                dot.addEventListener('click', function() {
                    goToSlide(index);
                    startAutoPlay(); // Reset timer khi click
                });
            });

            // Event listeners cho arrows
            if (prevBtn) {
                prevBtn.addEventListener('click', function() {
                    prevSlide();
                    startAutoPlay();
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function() {
                    nextSlide();
                    startAutoPlay();
                });
            }

            // Khởi động slider
            goToSlide(0);
            startAutoPlay();

            /* --- DINING SLIDER: INFINITE LOOP LOGIC --- */
            var diningSlider = document.getElementById('diningSlider');
            if (diningSlider) {
                var diningTrack = diningSlider.querySelector('.dining-slider__track');
                var originalSlides = Array.prototype.slice.call(diningSlider.querySelectorAll('.dining-slider__slide'));
                var diningInterval = null;
                var diningDelay = 3500;
                
                // Clone first and last slides for infinite loop
                var firstClone = originalSlides[0].cloneNode(true);
                var lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);

                // Add clones to track
                diningTrack.appendChild(firstClone);
                diningTrack.insertBefore(lastClone, originalSlides[0]);

                var allSlides = Array.prototype.slice.call(diningSlider.querySelectorAll('.dining-slider__slide'));
                var diningIndex = 1; // Start at real first slide (index 1 because of clone)

                // Initial positioning
                diningTrack.style.transform = 'translateX(-100%)';

                var isTransitioning = false;

                function updateDiningTrack(transition) {
                    diningTrack.style.transition = transition ? 'transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
                    diningTrack.style.transform = 'translateX(' + (-diningIndex * 100) + '%)';
                }

                function goToDiningSlide(index) {
                    if (isTransitioning) return;
                    isTransitioning = true;
                    diningIndex = index;
                    updateDiningTrack(true);
                }

                // Handle continuous loop logic after transition ends
                diningTrack.addEventListener('transitionend', function () {
                    isTransitioning = false;
                    if (diningIndex === allSlides.length - 1) { // Reached Clone of First
                        diningIndex = 1; // Jump to Real First
                        updateDiningTrack(false);
                    } else if (diningIndex === 0) { // Reached Clone of Last
                        diningIndex = allSlides.length - 2; // Jump to Real Last
                        updateDiningTrack(false);
                    }
                });

                function nextDiningSlide() {
                    // Always allow next, because of clones
                    goToDiningSlide(diningIndex + 1);
                }

                function prevDiningSlide() {
                    // Always allow prev, because of clones
                    goToDiningSlide(diningIndex - 1);
                }

                // Autoplay
                function startDiningAutoPlay() {
                    stopDiningAutoPlay();
                    diningInterval = window.setInterval(function () {
                        nextDiningSlide();
                    }, diningDelay);
                }

                function stopDiningAutoPlay() {
                    if (diningInterval) {
                        window.clearInterval(diningInterval);
                        diningInterval = null;
                    }
                }

                // Controls
                var diningPrev = diningSlider.querySelector('[data-direction="prev"]');
                var diningNext = diningSlider.querySelector('[data-direction="next"]');

                if (diningPrev) {
                    diningPrev.addEventListener('click', function () {
                        prevDiningSlide();
                        startDiningAutoPlay();
                    });
                }

                if (diningNext) {
                    diningNext.addEventListener('click', function () {
                        nextDiningSlide();
                        startDiningAutoPlay();
                    });
                }

                diningSlider.addEventListener('mouseenter', stopDiningAutoPlay);
                diningSlider.addEventListener('mouseleave', startDiningAutoPlay);

                startDiningAutoPlay();
            }
        });
    </script>
}