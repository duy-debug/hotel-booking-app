        .hero-slide .btn-primary {
            background: #0B3F84 !important;
            color: #ffffff;
            padding: 16px 36px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 999px;
            border: none;
            cursor: pointer;
            box-shadow: 0 8px 30px rgba(14, 165, 233, 0.4);
